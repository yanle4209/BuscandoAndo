# BuscandoAndo — variables para docker compose / Coolify
#
# LOCAL:
#   cp .env.coolify.example .env      # y rellena los valores marcados
#   docker compose up -d --build
#
# COOLIFY: no se usa este fichero tal cual. Copia cada variable en
#   Application -> Environment Variables (o pega el bloque entero con
#   el boton "Developer view"). Ver COOLIFY.md, seccion 5.
#
# Regla: este fichero se versiona SIN secretos. El .env real NO se
# versiona (ya esta en .gitignore).

# ---------------------------------------------------------------------
# OBLIGATORIAS
# ---------------------------------------------------------------------

# Clave de firma de Django. Generar una nueva, nunca reutilizar la de
# produccion actual:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Password del Postgres del compose. Solo la usan "db" y "app" entre
# ellas; no se expone al exterior.
POSTGRES_PASSWORD=

# Hosts que Django acepta. Con dominio propio, el dominio y su www.
# Se pueden anadir IPs mientras se prueba.
ALLOWED_HOSTS=localhost,127.0.0.1

# Dominio publico real (canonical, og:url, sitemap). Sin barra final.
SITIO_URL=http://localhost:8000

# ---------------------------------------------------------------------
# RECOMENDADAS
# ---------------------------------------------------------------------

DEBUG=False

# Origenes permitidos por CORS. Con el SPA servido por el mismo Django
# no hace falta ninguno; se dejan por si se usa el dev server de Vite.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Origenes de confianza para el CSRF del admin. Necesario si el panel
# se abre por un dominio distinto al Host que ve el contenedor o por
# IP:puerto antes de apuntar el DNS. Ejemplo:
#   CSRF_TRUSTED_ORIGINS=https://buscandoando.app,https://www.buscandoando.app
CSRF_TRUSTED_ORIGINS=

# Superusuario inicial. Sin DJANGO_SUPERUSER_PASSWORD el comando no
# crea nada (y lo avisa en el log), asi que en el primer despliegue
# conviene definirla y luego cambiarla desde /admin/.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@buscandoando.app

# ---------------------------------------------------------------------
# BASE DE DATOS
# ---------------------------------------------------------------------
# Por defecto el compose levanta su propio Postgres y compone la URL.
# Para usar una base externa (el Postgres gestionado de Coolify, Neon,
# Supabase...), define DATABASE_URL y borra el servicio "db" del
# compose (ver COOLIFY.md, seccion 7).
#
# DATABASE_URL=postgresql://usuario:password@host:5432/basededatos?sslmode=require
DATABASE_URL=

# Nombre/base del Postgres interno. Cambiarlos obliga a recrear el
# volumen pg_data (los datos viejos quedan huerfanos).
POSTGRES_DB=buscandoando
POSTGRES_USER=buscandoando

# ---------------------------------------------------------------------
# PROCESO
# ---------------------------------------------------------------------
PORT=8000
WEB_CONCURRENCY=2
WEB_THREADS=4
GUNICORN_TIMEOUT=120

# 1 = esperar a que la BD acepte conexiones antes de migrar.
ESPERAR_BD=1

# 1 = cargar las ~1.800 fichas nacionales en el arranque. Apagado por
# defecto: es una carga pesada y en Render se decidio correrla a mano
# (DISENO.md 15.5). Encender solo en el primer arranque de una base
# vacia y volver a apagarlo.
CARGAR_FICHAS=0

# ---------------------------------------------------------------------
# FASE GEOGRAFICA (DISENO.md §13)
# ---------------------------------------------------------------------
# Vacio = todo el pais. Por defecto se mantiene la beta de Moca.
FASE1_PROVINCIAS=Espaillat
FASE1_MUNICIPIOS=Moca

# ---------------------------------------------------------------------
# IMAGENES (opcional)
# ---------------------------------------------------------------------
# Vacias: las fotos van al volumen media_data del contenedor.
# Con valores: van a Cloudinary (lo que usa la produccion actual).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
