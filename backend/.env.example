# BuscandoAndo — variables de entorno
#
# OJO: Django NO carga este fichero automáticamente (el proyecto no usa
# python-dotenv). Cópialo a .env solo como plantilla y define las
# variables en el entorno antes de arrancar, p. ej. en PowerShell:
#     $env:SECRET_KEY="..."
#     $env:DEBUG="True"
# En Render se definen en el panel del servicio; en serv00, en
# env.production (lo lee passenger_wsgi.py).

# --- Django ---
# Clave maestra de firmas. En producción NUNCA usar la de por defecto.
SECRET_KEY=cambiar-en-produccion
# False = modo producción (cookies Secure, HSTS, CSP, 404 genérico)
DEBUG=True
# Hosts permitidos (coma separados)
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# Por defecto SQLite local (backend/db.sqlite3). Para PostgreSQL:
USE_POSTGRES=False
# Opción A: URL completa (Neon/Render) — tiene prioridad sobre la B:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# Opción B: campos sueltos:
DB_NAME=buscandoando
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- CORS ---
# Orígenes permitidos para el dev server de Vite (:5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Fase geográfica (DISENO.md §13) ---
# Provincias visibles en el listado. Vacío = todo el país (sin fase).
FASE1_PROVINCIAS=Espaillat,Santiago,La Vega,Hermanas Mirabal

# --- SEO ---
# URL pública del sitio: canonical, og:url y <loc> del sitemap
SITIO_URL=http://localhost:8000

# --- Estáticos ---
# En serv00 hay que apuntarlo a public/ para que nginx los sirva desde disco:
# STATIC_ROOT=/home/user/domains/DOMAIN/public_python/public/static

# --- Imágenes (Cloudinary) ---
# El storage siempre es Cloudinary: sin credenciales, en local las fichas
# CON imagen dan 500 (las de produccion no, alla estan configuradas).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin inicial (manage.py setup_admin) ---
# Sin DJANGO_SUPERUSER_PASSWORD el comando NO crea nada y lo avisa.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.com
